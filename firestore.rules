rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    match /users/{userId} {

      match /profile/data {
        allow read, write: if isOwner(userId);
      }

      match /bloodTests/{testId} {
        allow read, delete: if isOwner(userId);
        allow create: if isOwner(userId)
          && request.resource.data.keys().hasAll(['date', 'values', 'createdAt'])
          && request.resource.data.date is string
          && request.resource.data.values is map;
        allow update: if isOwner(userId);
      }

      match /nutrition/{entryId} {
        allow read, delete: if isOwner(userId);
        allow create: if isOwner(userId)
          && request.resource.data.keys().hasAll(['name', 'date', 'createdAt'])
          && request.resource.data.date is string;
        allow update: if isOwner(userId);
      }

      match /supplements/{supplementId} {
        allow read, delete: if isOwner(userId);
        allow create: if isOwner(userId)
          && request.resource.data.keys().hasAll(['name', 'createdAt'])
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 100;
        allow update: if isOwner(userId);
      }

      match /training/{trainingId} {
        allow read, delete: if isOwner(userId);
        allow create: if isOwner(userId)
          && request.resource.data.keys().hasAll(['type', 'date', 'createdAt'])
          && request.resource.data.date is string;
        allow update: if isOwner(userId);
      }

      match /analysisCache/{cacheId} {
        allow read, write: if isOwner(userId);
      }

      match /{subcollection}/{docId} {
        allow read, write: if isOwner(userId);
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}